                                      // x16 = 14

00000013   // nop

00a28013   // addi x0,  x5, 10       // [검증 1] x0에 20 쓰기 시도 (oWrEn_Reg=1 이지만 rd=0)
00100893   // addi x17, x0, 1        // 1사이클 뒤 x0 사용 -> 정상: x17 = 1 (포워딩 뚫리면 21)

006022a3   // sw   x6,  5(x0)        // [검증 2] 오프셋 5 -> inst[11:7] 자리가 5(x5)인 함정! (oWrEn_Reg=0)
00228913   // addi x18, x5, 2        // 1사이클 뒤 x5(10) 사용 -> 정상: x18 = 12 (sw 주소 5가 포워딩되면 7)

00628263   // beq  x5,  x6, +4       // [검증 3] x5(10) != x6(13) 이므로 분기 안 함! 오프셋 4 -> inst[11:7]이 5(x5)인 함정!
00328993   // addi x19, x5, 3        // 1사이클 뒤 x5(10) 사용 -> 정상: x19 = 13 (beq 타겟 주소가 포워딩되면 오답)
