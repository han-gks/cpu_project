// === [초기 세팅: 메모리에 테스트용 값 저장] ===
02a00293   // 0x00: addi x5, x0, 42      // x5 = 42
00502023   // 0x04: sw   x5, 0(x0)       // Mem[0] = 42 저장 (1사이클 포워딩 on sw rs2)

// === [Case 1: 기본 Load-Use Stall (rs1, rs2 동시 의존)] ===
00002303   // 0x08: lw   x6, 0(x0)       // x6 = Mem[0] = 42 로드
006303b3   // 0x0C: add  x7, x6, x6      // [1클럭 Stall 필수!] x7 = 42 + 42 = 84

// === [Case 2: Load to x0 함정 (절대 Stall 걸리면 안 됨)] ===
00002003   // 0x10: lw   x0, 0(x0)       // x0에 로드 시도 (무시되어야 함)
00138413   // 0x14: addi x8, x7, 1       // x0가 아니라 x7을 쓰지만, 만약 아래 줄에서
008004b3   // 0x18: add  x9, x0, x8      // lw x0 직후 x0를 읽어도 Stall 없이 x9 = 0 + 85 = 85

// === [Case 3: Load-Use 직후 Branch Taken (Stall -> Fwd -> Flush 연쇄 반응)] ===
05500513   // 0x1C: addi x10, x0, 85     // 비교용 값 x10 = 85
00a02223   // 0x20: sw   x10, 4(x0)      // Mem[4] = 85 저장
00402583   // 0x24: lw   x11, 4(x0)      // x11 = 85 로드
00958663   // 0x28: beq  x11, x9, +12    // [1클럭 Stall 후 Fwd!] x11(85) == x9(85) 성립 -> 0x34로 점프!
06300613   // 0x2C: addi x12, x0, 99     // [Flush 대상 1 - IF/ID 또는 ID/EX에서 소멸되어야 함]
06300693   // 0x30: addi x13, x0, 99     // [Flush 대상 2 - 실행되면 절대 안 됨!]

// === [Case 4: JAL Jump Flush 및 복귀 주소(PC+4) 보존 확인] ===
00c00713   // 0x34: addi x14, x0, 12     // 분기 도착지! 정상 실행 시 x14 = 12
00c007ef   // 0x38: jal  x15, +12        // x15에 PC+4(0x3C) 저장 후 0x44로 점프!
06300613   // 0x3C: addi x12, x0, 99     // [Flush 대상 1]
06300693   // 0x40: addi x13, x0, 99     // [Flush 대상 2]
00170813   // 0x44: addi x16, x14, 1     // JAL 도착지! x16 = 12 + 1 = 13
00000013   // 0x48: nop