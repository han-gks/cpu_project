00000e13   // 0x000: addi  x28, x0, 0       // 실패 횟수 초기화 = 0
00000c13   // 0x004: addi  x24, x0, 0       // 동기 예외 진입 횟수 = 0
00000c93   // 0x008: addi  x25, x0, 0       // MEI(외부 인터럽트) 횟수 = 0
00000d13   // 0x00C: addi  x26, x0, 0       // MTI(타이머 인터럽트) 횟수 = 0
00000d93   // 0x010: addi  x27, x0, 0       // MSI(SW 인터럽트) 횟수 = 0
10000093   // 0x014: addi  x1,  x0, 0x100   // 트랩 핸들러 베이스 주소 = 0x100
30509073   // 0x018: csrrw x0,  mtvec, x1   // mtvec = 0x100 설정
30046073   // 0x01C: csrrsi x0, mstatus, 8  // mstatus.MIE = 1 활성화

00000073   // 0x020: ecall                  // [1단계-A] ECALL 동기 예외 발생 (mepc=0x020, mcause=11)
001e0e13   // 0x024: addi  x28, x28, 1      // [Flush 검증] ecall 직후 명령어 -> 반드시 Flush 되어야 함
00b00f13   // 0x028: addi  x30, x0, 11      // 기대 mcause = 11 (EXC_ECALL_M)
01eb9463   // 0x02C: bne   x23, x30, +8     // mcause 불일치 시 실패
0080006f   // 0x030: jal   x0,  +8
001e0e13   // 0x034: addi  x28, x28, 1
02000f13   // 0x038: addi  x30, x0, 0x020   // 기대 mepc = 0x020
01eb1463   // 0x03C: bne   x22, x30, +8     // mepc 불일치 시 실패
0080006f   // 0x040: jal   x0,  +8
001e0e13   // 0x044: addi  x28, x28, 1

ffffffff   // 0x048: .word 0xffffffff       // [1단계-B] Illegal Instruction 예외 발생 (mepc=0x048, mcause=2)
001e0e13   // 0x04C: addi  x28, x28, 1      // [Flush 검증] illegal 직후 명령어 -> 반드시 Flush 되어야 함
00200f13   // 0x050: addi  x30, x0, 2       // 기대 mcause = 2 (EXC_ILLEGAL_INST)
01eb9463   // 0x054: bne   x23, x30, +8     // mcause 불일치 시 실패
0080006f   // 0x058: jal   x0,  +8
001e0e13   // 0x05C: addi  x28, x28, 1
04800f13   // 0x060: addi  x30, x0, 0x048   // 기대 mepc = 0x048
01eb1463   // 0x064: bne   x22, x30, +8     // mepc 불일치 시 실패
0080006f   // 0x068: jal   x0,  +8
001e0e13   // 0x06C: addi  x28, x28, 1

000010b7   // 0x070: lui   x1,  1           // x1 = 0x1000
88808093   // 0x074: addi  x1,  x1, -1912   // x1 = 0x888 (MEIE[11] | MTIE[7] | MSIE[3])
30409073   // 0x078: csrrw x0,  mie, x1     // mie = 0x888 활성화
00a00113   // 0x07C: addi  x2,  x0, 10      // x2 = 10
00202023   // 0x080: sw    x2,  0(x0)       // Mem[0] = 10
00000513   // 0x084: addi  x10, x0, 0       // 누적합 x10 = 0
00000593   // 0x088: addi  x11, x0, 0       // 루프 카운터 x11 = 0
00a00613   // 0x08C: addi  x12, x0, 10      // 루프 목표 횟수 x12 = 10

00002183   // 0x090: lw    x3,  0(x0)       // [LOOP] x3 = Mem[0] = 10
00350533   // 0x094: add   x10, x10, x3     // [Load-Use 지점] x10 += 10
00158593   // 0x098: addi  x11, x11, 1      // x11 += 1
00b58463   // 0x09C: beq   x11, x11, +8     // [Taken Branch 지점] 항상 0x0A4로 점프
001e0e13   // 0x0A0: addi  x28, x28, 1      // 분기 Flush 확인용 함정
fec596e3   // 0x0A4: bne   x11, x12, -20    // x11 != 10 이면 0x090(LOOP)으로 반복

06400f13   // 0x0A8: addi  x30, x0, 100     // 기대 누적합 = 100
01e51463   // 0x0AC: bne   x10, x30, +8     // 인터럽트 개입 후에도 연산 결과가 100인지 확인
0080006f   // 0x0B0: jal   x0,  +8
001e0e13   // 0x0B4: addi  x28, x28, 1
00200f13   // 0x0B8: addi  x30, x0, 2       // 기대 동기 예외 횟수 = 2
01ec1463   // 0x0BC: bne   x24, x30, +8
0080006f   // 0x0C0: jal   x0,  +8
001e0e13   // 0x0C4: addi  x28, x28, 1
000e0f93   // 0x0C8: addi  x31, x28, 0      // 최종 결과 x31 = x28 (0이면 PASS)
01f02223   // 0x0CC: sw    x31, 4(x0)       // 합성 최적화(증발) 방지용 결과 메모리 저장 Mem[4] = x31
0000006f   // 0x0D0: jal   x0,  0           // [DONE] 무한 루프 대기

00000013   // 0x0D4: nop
00000013   // 0x0D8: nop
00000013   // 0x0DC: nop
00000013   // 0x0E0: nop
00000013   // 0x0E4: nop
00000013   // 0x0E8: nop
00000013   // 0x0EC: nop
00000013   // 0x0F0: nop
00000013   // 0x0F4: nop
00000013   // 0x0F8: nop
00000013   // 0x0FC: nop

34202a73   // 0x100: csrrs x20, mcause, x0  // [TRAP HANDLER] mcause 읽기
000a4e63   // 0x104: blt   x20, x0, +28     // MSB==1(음수)이면 인터럽트 핸들러(0x120)로 분기
000a0b93   // 0x108: addi  x23, x20, 0      // [동기 예외] x23에 mcause 백업
34102b73   // 0x10C: csrrs x22, mepc, x0    // x22에 원래 mepc 백업
001c0c13   // 0x110: addi  x24, x24, 1      // 동기 예외 카운터 x24 += 1
008b0a93   // 0x114: addi  x21, x22, 8      // 복귀 주소 = mepc + 8 (예외 명령어 + 직후 함정 명령어 스킵)
341a9073   // 0x118: csrrw x0,  mepc, x21   // mepc 갱신
30200073   // 0x11C: mret                   // 예외 복귀

00fa7a13   // 0x120: andi  x20, x20, 15     // [인터럽트 핸들러] 하위 4비트 원인 코드 추출
00b00a93   // 0x124: addi  x21, x0, 11      // Code 11 (MEI)?
015a1663   // 0x128: bne   x20, x21, +12    // 아니면 0x134로
001c8c93   // 0x12C: addi  x25, x25, 1      // MEI 카운터 x25 += 1
30200073   // 0x130: mret                   // 인터럽트 복귀 (mepc 그대로 복귀)
00700a93   // 0x134: addi  x21, x0, 7       // Code 7 (MTI)?
015a1663   // 0x138: bne   x20, x21, +12    // 아니면 0x144로
001d0d13   // 0x13C: addi  x26, x26, 1      // MTI 카운터 x26 += 1
30200073   // 0x140: mret                   // 인터럽트 복귀
00300a93   // 0x144: addi  x21, x0, 3       // Code 3 (MSI)?
015a1463   // 0x148: bne   x20, x21, +8     // 아니면 0x150으로
001d8d93   // 0x14C: addi  x27, x27, 1      // MSI 카운터 x27 += 1
30200073   // 0x150: mret                   // 인터럽트 복귀
